{
  "uid": "energy-tracker-k6",
  "title": "k6 Load Tests",
  "description": "Results of the k6 scenarios in load-tests/, next to what the services report about themselves.",
  "tags": [
    "energy-tracker",
    "k6",
    "load-test"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "testid"
        },
        "definition": "label_values(k6_vus, testid)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Services Overview",
      "type": "link",
      "url": "/d/energy-tracker-services"
    }
  ],
  "panels": [
