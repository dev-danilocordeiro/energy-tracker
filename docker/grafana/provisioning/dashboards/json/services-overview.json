{
  "uid": "energy-tracker-services",
  "title": "Services Overview",
  "description": "HTTP, JVM and connection pool metrics for the Home Energy Tracker Spring Boot services.",
  "tags": [
    "energy-tracker",
    "spring-boot",
    "jvm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
