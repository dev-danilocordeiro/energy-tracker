meta {
  name: Send energy usage - sem timestamp
  type: http
  seq: 2
}

post {
  url: {{ingestionBaseUrl}}/api/v1/ingestion
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "deviceId": {{deviceId}},
    "energyConsumed": 0.8
  }
}

docs {
  O timestamp e obrigatorio (@NotNull no EnergyUsageDto). A requisicao e
  rejeitada antes de chegar ao Kafka e o corpo vem como problem+json.
}

tests {
  test("responde 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("responde no formato problem+json", function() {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
}
