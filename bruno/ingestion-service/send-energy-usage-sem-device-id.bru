meta {
  name: Send energy usage - sem deviceId
  type: http
  seq: 4
}

post {
  url: {{ingestionBaseUrl}}/api/v1/ingestion
  body: json
  auth: none
}

body:json {
  {
    "energyConsumed": 1.25,
    "timestamp": "{{ingestionTimestamp}}"
  }
}

docs {
  Sem deviceId a leitura seria gravada no InfluxDB com a tag "null" e quebraria
  a agregacao do usage-service. O @NotNull no EnergyUsageDto barra a requisicao
  com 400 antes de publicar no Kafka.
}

script:pre-request {
  bru.setVar("ingestionTimestamp", new Date().toISOString());
}

tests {
  test("responde 400 Bad Request", function() {
    expect(res.getStatus()).to.equal(400);
  });

  test("responde no formato problem+json", function() {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });
}
