meta {
  name: Get saving tips
  type: http
  seq: 1
}

get {
  url: {{insightBaseUrl}}/api/v1/insight/saving-tips/{{userId}}
  body: none
  auth: none
}

docs {
  Busca o consumo dos ultimos 3 dias no usage-service e pede dicas de economia
  ao Ollama. Precisa do usage-service, do device-service e do Ollama no ar, e de
  um usuario com dispositivos cadastrados ("Create device" antes desta).

  A resposta do modelo pode levar dezenas de segundos.
}

tests {
  test("responde 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o insight do usuario pedido", function() {
    expect(res.body.userId).to.equal(Number(bru.getEnvVar("userId")));
  });

  test("traz as dicas geradas pelo modelo", function() {
    expect(res.body.tips).to.be.a("string").and.not.be.empty;
  });

  test("traz o consumo total do periodo", function() {
    expect(res.body.energyUsage).to.be.a("number").and.to.be.at.least(0);
  });
}
