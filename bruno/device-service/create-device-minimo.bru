meta {
  name: Create device - campos minimos
  type: http
  seq: 2
}

post {
  url: {{deviceBaseUrl}}/api/v1/device
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Sensor sem dono"
  }
}

docs {
  Todas as colunas de device sao nullable e o DeviceDto ainda nao tem bean
  validation, entao um corpo quase vazio e aceito e grava um dispositivo orfao,
  sem type nem userId. Quando a validacao na borda entrar, este cadastro deve
  passar a responder 400 - troque o teste abaixo.
}

tests {
  test("responde 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("campos ausentes voltam nulos", function() {
    expect(res.body.type).to.equal(null);
    expect(res.body.location).to.equal(null);
    expect(res.body.userId).to.equal(null);
  });
}
