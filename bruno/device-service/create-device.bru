meta {
  name: Create device
  type: http
  seq: 1
}

post {
  url: {{deviceBaseUrl}}/api/v1/device
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Termostato da sala",
    "type": "THERMOSTAT",
    "location": "Sala de estar",
    "userId": {{userId}}
  }
}

docs {
  device.user_id tem FOREIGN KEY para user(id), entao o userId precisa existir -
  rode "Create user" (pasta user-service) antes desta requisicao.

  Valores aceitos em type: SPEAKER, GPS, CAMERA, THERMOSTAT, LIGHT, LOCK, DOORBELL.
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("deviceId", res.body.id);
  }
}

tests {
  test("responde 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("devolve o id gerado", function() {
    expect(res.body.id).to.be.a("number");
  });

  test("ecoa os campos enviados", function() {
    expect(res.body.name).to.equal("Termostato da sala");
    expect(res.body.type).to.equal("THERMOSTAT");
    expect(res.body.location).to.equal("Sala de estar");
    expect(res.body.userId).to.equal(Number(bru.getEnvVar("userId")));
  });
}
