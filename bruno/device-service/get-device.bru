meta {
  name: Get device by id
  type: http
  seq: 5
}

get {
  url: {{deviceBaseUrl}}/api/v1/device/{{deviceId}}
  body: none
  auth: none
}

docs {
  Usa o deviceId salvo por "Create device", entao rode aquela requisicao antes
  desta.
}

tests {
  test("responde 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o dispositivo pedido", function() {
    expect(res.body.id).to.equal(Number(bru.getEnvVar("deviceId")));
  });

  test("traz o corpo completo do dispositivo", function() {
    expect(res.body).to.have.property("name");
    expect(res.body).to.have.property("type");
    expect(res.body).to.have.property("location");
    expect(res.body).to.have.property("userId");
  });
}
