meta {
  name: Delete device
  type: http
  seq: 9
}

delete {
  url: {{deviceBaseUrl}}/api/v1/device/{{deviceId}}
  body: none
  auth: none
}

docs {
  Remove o dispositivo criado por "Create device". Depois desta requisicao o
  deviceId do ambiente aponta para um registro que nao existe mais - rode
  "Create device" de novo antes de repetir as requisicoes anteriores.

  Apagar o usuario dono (Delete user) tambem remove os dispositivos dele, por
  causa do ON DELETE CASCADE em fk_device_user.
}

tests {
  test("responde 204 No Content", function() {
    expect(res.getStatus()).to.equal(204);
  });

  test("nao devolve corpo", function() {
    expect(res.getBody()).to.be.oneOf([undefined, null, ""]);
  });
}
