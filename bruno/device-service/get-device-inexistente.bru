meta {
  name: Get device by id - inexistente
  type: http
  seq: 6
}

get {
  url: {{deviceBaseUrl}}/api/v1/device/999999999
  body: none
  auth: none
}

docs {
  O service lanca DeviceNotFoundException e o RestExceptionHandler responde um
  ProblemDetail (RFC 7807), com Content-Type application/problem+json.
}

tests {
  test("responde 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("responde no formato problem+json", function() {
    expect(res.getHeader("content-type")).to.include("application/problem+json");
  });

  test("traz o problem detail completo", function() {
    expect(res.body.type).to.equal("https://energy-tracker.devcordeiro.com/problems/device-not-found");
    expect(res.body.title).to.equal("Device not found");
    expect(res.body.status).to.equal(404);
    expect(res.body.detail).to.equal("Device not found with id 999999999");
    expect(res.body.instance).to.equal("/api/v1/device/999999999");
    expect(res.body.timestamp).to.be.a("string");
  });
}
