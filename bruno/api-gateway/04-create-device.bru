meta {
  name: Create device
  type: http
  seq: 4
}

post {
  url: {{gatewayBaseUrl}}/api/v1/device
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Termostato da sala",
    "type": "THERMOSTAT",
    "location": "Sala de estar",
    "userId": {{userId}}
  }
}

docs {
  Rota device-service -> localhost:8082. Usa o userId gravado por "Create user".
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("deviceId", res.body.id);
  }
}

tests {
  test("responde 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("devolve o id gerado", function() {
    expect(res.body.id).to.be.a("number");
  });

  test("vincula ao usuario criado", function() {
    expect(res.body.userId).to.equal(Number(bru.getEnvVar("userId")));
  });
}
