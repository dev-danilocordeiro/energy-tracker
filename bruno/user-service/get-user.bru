meta {
  name: Get user by id
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/user/{{userId}}
  body: none
  auth: none
}

docs {
  Usa o userId salvo por "Create user", entao rode aquela requisicao antes desta.
}

tests {
  test("responde 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("devolve o usuario pedido", function() {
    expect(res.body.id).to.equal(Number(bru.getEnvVar("userId")));
    expect(res.body.email).to.equal(bru.getEnvVar("userEmail"));
  });

  test("traz o corpo completo do usuario", function() {
    expect(res.body).to.have.property("name");
    expect(res.body).to.have.property("surname");
    expect(res.body).to.have.property("address");
    expect(res.body).to.have.property("alerting");
    expect(res.body).to.have.property("energyAlertingThreshold");
  });
}
