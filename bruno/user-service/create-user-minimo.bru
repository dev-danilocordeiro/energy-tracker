meta {
  name: Create user - campos minimos
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/user
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno",
    "email": "{{emailAleatorio}}"
  }
}

script:pre-request {
  bru.setVar("emailAleatorio", `bruno.minimo+${Date.now()}@example.com`);
}

tests {
  test("responde 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("aplica os defaults de alerta", function() {
    expect(res.body.alerting).to.equal(false);
    expect(res.body.energyAlertingThreshold).to.equal(0);
  });

  test("campos opcionais voltam nulos", function() {
    expect(res.body.surname).to.equal(null);
    expect(res.body.address).to.equal(null);
  });
}
