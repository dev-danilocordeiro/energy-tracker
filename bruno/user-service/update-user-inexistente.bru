meta {
  name: Update user - inexistente
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/user/999999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ninguem",
    "email": "ninguem@example.com"
  }
}

docs {
  Mesmo ProblemDetail do GET - o controller nao trata mais a excecao, quem
  responde e o RestExceptionHandler.
}

tests {
  test("responde 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("traz o problem detail do usuario ausente", function() {
    expect(res.body.title).to.equal("User not found");
    expect(res.body.detail).to.equal("User not found with id 999999999");
    expect(res.body.instance).to.equal("/api/v1/user/999999999");
  });
}
