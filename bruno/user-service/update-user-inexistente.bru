meta {
  name: Update user - inexistente
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/user/999999999
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ninguem",
    "email": "ninguem@example.com"
  }
}

docs {
  O service lanca IllegalArgumentException e o controller traduz para 404 com o
  texto "User not found".
}

tests {
  test("responde 404 Not Found", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("explica o motivo", function() {
    expect(String(res.getBody())).to.equal("User not found");
  });
}
