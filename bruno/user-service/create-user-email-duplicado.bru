meta {
  name: Create user - email duplicado
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/user
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Ana",
    "surname": "Souza",
    "email": "{{userEmail}}",
    "address": "Rua das Flores, 120 - Sao Paulo/SP",
    "alerting": true,
    "energyAlertingThreshold": 350.5
  }
}

docs {
  Reenvia o e-mail salvo por "Create user" (variavel userEmail), entao rode aquela
  requisicao antes desta.

  A violacao da UNIQUE KEY uk_user_email vira DataIntegrityViolationException, que
  o RestExceptionHandler traduz para 409 com um ProblemDetail. A mensagem original
  do banco fica so no log, em nivel WARN.
}

tests {
  test("responde 409 Conflict", function() {
    expect(res.getStatus()).to.equal(409);
  });

  test("traz o problem detail do conflito", function() {
    expect(res.body.type).to.equal("https://energy-tracker.devcordeiro.com/problems/user-conflict");
    expect(res.body.title).to.equal("User conflicts with existing data");
    expect(res.body.status).to.equal(409);
  });

  test("nao vaza detalhe do banco", function() {
    expect(JSON.stringify(res.getBody())).to.not.include("uk_user_email");
  });
}
